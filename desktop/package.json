{
  "name": "rsvp-desktop",
  "version": "1.0.0",
  "description": "Desktop wrapper for Layali",
  "author": "GitHub Copilot",
  "private": true,
  "main": "main.js",
  "scripts": {
    "prepare:embedded": "node prepare-build-config.js embedded",
    "prepare:remote": "node prepare-build-config.js remote https://desktop-g6nikgc.tail35eb9d.ts.net/api",
    "rename:remote": "node rename-remote-artifact.js",
    "start": "npm run prepare:embedded && npm run build:frontend && electron .",
    "build:frontend": "npm --prefix ../frontend run build",
    "dist": "npm run prepare:embedded && npm run build:frontend && electron-builder --win nsis",
    "dist:remote": "npm run prepare:remote && npm run build:frontend && electron-builder --win nsis && npm run rename:remote",
    "pack": "npm run prepare:embedded && npm run build:frontend && electron-builder --dir",
    "pack:remote": "npm run prepare:remote && npm run build:frontend && electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^35.1.4",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.tfadl.rsvpdesktop",
    "productName": "Layali",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "build-config.json",
        "to": "app-config.json"
      },
      {
        "from": "../frontend/build",
        "to": "frontend-build"
      },
      {
        "from": "../backend",
        "to": "backend"
      }
    ],
    "win": {
      "icon": "icon.svg",
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "installerIcon": "icon.svg",
      "uninstallerIcon": "icon.svg",
      "installerHeaderIcon": "icon.svg"
    }
  }
}