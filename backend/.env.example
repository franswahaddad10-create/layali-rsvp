PORT=5000
MONGODB_URI=mongodb://localhost:27017/rsvp_app_layali
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
ALLOWED_ORIGINS=http://localhost:7000
ENABLE_SEED_ADMIN=false
AUTH_RATE_LIMIT_MAX=10
PUBLIC_RSVP_RATE_LIMIT_MAX=30
WEBHOOK_RATE_LIMIT_MAX=120
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# WhatsApp provider: twilio or meta
WHATSAPP_PROVIDER=twilio

# WhatsApp Business API (Twilio)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890
TWILIO_INVITATION_CONTENT_SID=your_invitation_content_sid
TWILIO_RSVP_MODE=reply

# WhatsApp Cloud API (Meta)
META_ACCESS_TOKEN=your_meta_access_token
META_PHONE_NUMBER_ID=your_meta_phone_number_id
META_TEMPLATE_NAME=your_meta_template_name
META_TEMPLATE_LANGUAGE=en
META_WEBHOOK_VERIFY_TOKEN=your_meta_webhook_verify_token
META_GRAPH_VERSION=v22.0

# App Settings
APP_NAME=Layali
APP_URL=http://localhost:7000
